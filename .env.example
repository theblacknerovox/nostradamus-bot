# =============================================
# NOSTRADAMUS BOT - CONFIGURAÇÃO
# Copie este arquivo para .env e preencha
# =============================================

# --- BINANCE (obrigatório) ---
BINANCE_API_KEY=cole_sua_api_key_aqui
BINANCE_SECRET_KEY=cole_sua_secret_key_aqui

# --- SEGURANÇA (obrigatório) ---
# Gere com: python3 gerar_senha.py
ADMIN_PASSWORD_HASH=cole_o_hash_gerado_aqui
JWT_SECRET=troque_por_uma_string_aleatoria_longa_ex_xk92mZp4nQ

# --- PARÂMETROS DO BOT ---
LEVERAGE=2
RISK=0.01
RR=2
MAX_TRADES=2
DAILY_LOSS_LIMIT=0.02
INTERVAL=10
MAX_PRICE=20
MIN_BACKTEST_CONFIDENCE=40
PROTECT_CAPITAL=true

# --- BANCO DE DADOS ---
DB_PATH=/app/data
